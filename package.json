{
  "name": "freehold",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "start:auth": "node --env-file-if-exists=.env.auth dist/src/auth-server.js",
    "start:scheduler": "node --env-file-if-exists=.env.scheduler dist/src/scheduler.js",
    "check:production": "node scripts/deployment-check.mjs --production --json",
    "verify:ledger": "node scripts/verify-ledger.mjs",
    "test": "npm run build && bash test/run-integration.sh",
    "test:integration": "node --test --test-concurrency=1 dist/test/integration.test.js",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:release": "node scripts/check-release.mjs && bash scripts/check-no-secrets.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.8",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED"
}
