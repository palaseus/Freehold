# Auth process only. Do not set DATABASE_URL in this file.
AUTH_DATABASE_URL=postgresql://freehold_auth:replace-me@localhost:5432/freehold
AUTH_INTERNAL_TOKEN=replace-with-32-plus-character-shared-secret
AUTH_BIND_HOST=127.0.0.1
AUTH_PORT=3002
REDIS_URL=redis://localhost:6379
# Same 32-byte key the financial API uses to enroll authenticators. The auth process decrypts it at login.
TOTP_ENCRYPTION_KEY=replace-with-base64-key
