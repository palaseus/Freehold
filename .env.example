# Financial API process. Do not put AUTH_DATABASE_URL or SCHEDULER_DATABASE_URL here.
# The API refuses to start if AUTH_DATABASE_URL is set.
DATABASE_URL=postgresql://freehold_api:replace-me@localhost:5432/freehold
AUTH_SERVICE_URL=http://127.0.0.1:3002
AUTH_INTERNAL_TOKEN=replace-with-32-plus-character-shared-secret
WORKER_DATABASE_URL=postgresql://freehold_worker:replace-me@localhost:5432/freehold
REDIS_URL=redis://localhost:6379
# Base64 encoding of exactly 32 random bytes, held outside PostgreSQL.
TOTP_ENCRYPTION_KEY=replace-with-base64-key
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=3000
NODE_ENV=development
# Local frontend origin and API port:
# PORT=3001
DEMO_MODE=false
# Only set for an explicitly enabled sandbox; provision matching DB settings via migrate.
DEMO_BOOTSTRAP_TOKEN=

# Migration process only. Not read by the API.
# MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/freehold
# API_DATABASE_PASSWORD=
# WORKER_DATABASE_PASSWORD=
# VERIFIER_DATABASE_PASSWORD=
# AUTH_DATABASE_PASSWORD=
# SCHEDULER_DATABASE_PASSWORD=
# BACKUP_DATABASE_PASSWORD=

# Auth process: copy .env.auth.example to .env.auth. Do not point it at this file.
# Scheduler process: copy .env.scheduler.example to .env.scheduler.
